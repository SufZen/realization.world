# Opportunity brief email (same relay and variables as the Live Lab form).
# Without SMTP_HOST and SUBMISSION_NOTIFY_EMAIL, the form falls back to
# "open in your email app" and the MCP submit_brief tool reports it is unavailable.
SMTP_HOST="smtp-relay.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Sender stays on the relay-allowlisted domain; briefs go to hello@.
SMTP_FROM="info@realization.co.il"
SUBMISSION_NOTIFY_EMAIL="hello@realization.world"

# Cookieless analytics (Umami). Leave empty to disable.
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Search engine ownership verification (meta tags).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Needed if more than one instance runs Server Actions.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
