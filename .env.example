# Opportunity brief email (same relay and variables as the Live Lab form).
# Without SMTP_HOST and SUBMISSION_NOTIFY_EMAIL, the form falls back to
# "open in your email app" and the MCP submit_brief tool reports it is unavailable.
SMTP_HOST="smtp-relay.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Sender stays on the relay-allowlisted domain; briefs go to hello@.
SMTP_FROM="info@realization.co.il"
SUBMISSION_NOTIFY_EMAIL="hello@realization.world"

# Cookieless analytics (self-hosted Umami), all build-time. Leave empty to disable.
# In production the tracker is proxied first-party: /stats/* -> UMAMI_PROXY_TARGET.
NEXT_PUBLIC_UMAMI_SRC="/stats/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_HOST_URL="https://realization.world/stats"
UMAMI_PROXY_TARGET="http://umami:3000"

# Search engine ownership verification (meta tags).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Needed if more than one instance runs Server Actions.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Webinar registrations -> "Webinar leads" Google Sheet (Apps Script web app, setup notes in the realization-studio repo, campaigns/webinar-2026-10/webinar.md).
# Optional: without these, registrations arrive by email only.
WEBINAR_SHEET_WEBHOOK_URL=""
WEBINAR_SHEET_SECRET=""

# Free deal check on /services/real-estate -> Google Sheet (Apps Script web app, same pattern as the webinar).
# Without these, the form keeps what the visitor typed and offers email or WhatsApp instead.
DEAL_CHECK_SHEET_WEBHOOK_URL=""
DEAL_CHECK_SHEET_SECRET=""
